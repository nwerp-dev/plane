# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS base

# Dependências úteis para builds nativos (sharp/canvas/bcrypt etc.)
RUN apk add --no-cache libc6-compat git python3 make g++ pkgconfig
# Fixar Yarn 1.x (se necessário)
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

# *****************************************************************************
# STAGE 1: Prune the project
# *****************************************************************************
FROM base AS builder
WORKDIR /app

# Turbo para gerar /out (json/full/yarn.lock)
RUN yarn global add turbo

# Copia o monorepo completo (respeita .dockerignore)
COPY . .

# Gera contexto minimizado para a app "live"
RUN turbo prune live --docker

# *****************************************************************************
# STAGE 2: Install dependencies & build the project
# *****************************************************************************
FROM base AS installer
WORKDIR /app

# Copia manifests isolados + lock
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/yarn.lock ./yarn.lock

# Instala dependências (com logs detalhados)
RUN --mount=type=cache,target=/root/.yarn \
    --mount=type=cache,target=/root/.cache \
    yarn install --frozen-lockfile --network-timeout 600000 --verbose

# Copia código filtrado pelo prune
COPY --from=builder /app/out/full/ .

# turbo.json pode estar fora do /out; traga do builder explicitamente
COPY --from=builder /app/turbo.json ./turbo.json

ENV TURBO_TELEMETRY_DISABLED=1

# Build apenas do app "live"
RUN yarn turbo build --filter=live

# *****************************************************************************
# STAGE 3: Run the project
# *****************************************************************************
FROM node:22-alpine AS runner
WORKDIR /app

# Apenas o necessário para runtime
COPY --from=installer /app/packages ./packages
COPY --from=installer /app/apps/live/dist ./live
COPY --from=installer /app/node_modules ./node_modules

ENV TURBO_TELEMETRY_DISABLED=1
EXPOSE 3000

CMD ["node", "live/server.js"]